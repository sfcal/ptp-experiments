{
  "id": null,
  "uid": "ptp",
  "title": "PTP",
  "tags": [
    "timing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Sync Chain Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "End-to-End Offset (per slave)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "scalar(phc2sys_offset_ns{job=\"node\"}) + ptp4l_offset_from_master_ns{job=\"ptp_clients\"} + phc2sys_offset_ns{job=\"ptp_clients\"}",
          "refId": "A",
          "legendFormat": "{{host}} (signed)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "scalar(abs(phc2sys_offset_ns{job=\"node\"})) + abs(ptp4l_offset_from_master_ns{job=\"ptp_clients\"}) + abs(phc2sys_offset_ns{job=\"ptp_clients\"})",
          "refId": "B",
          "legendFormat": "{{host}} (worst case)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ns"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*worst case.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "description": "Per-slave sum of the three sync-chain segments: GM Timecard->NIC (phc2sys) + network (ptp4l offset from master) + slave NIC->system clock (phc2sys). Signed sum is the net error the slave's system clock sees (segments can cancel); the dashed worst-case line sums |segment| values. Gaps appear if the GM collector is down (scalar() needs exactly one GM series)."
    },
    {
