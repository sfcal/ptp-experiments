{
  "id": null,
  "uid": "gps",
  "title": "GPS",
  "tags": [
    "timing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Fix Mode",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gpsd_mode",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No Fix",
                  "color": "red"
                },
                "1": {
                  "text": "No Fix",
                  "color": "red"
                },
                "2": {
                  "text": "2D Fix",
                  "color": "yellow"
                },
                "3": {
                  "text": "3D Fix",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
