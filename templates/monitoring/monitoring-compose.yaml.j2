# {{ ansible_managed }}
---
networks:
  monitoring:
    driver: bridge

services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    networks:
      - monitoring
    extra_hosts:
      - "host.docker.internal:host-gateway"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention }}'
    ports:
      - "{{ prometheus_port }}:9090"
    volumes:
      - {{ monitoring_deploy_path }}/prometheus:/etc/prometheus:ro
      - {{ monitoring_deploy_path }}/prometheus-data:/prometheus
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    networks:
      - monitoring
    depends_on:
      - prometheus
    environment:
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_USERS_ALLOW_SIGN_UP=false
      - TZ={{ system_timezone }}
    ports:
      - "{{ grafana_port }}:3000"
    volumes:
      - {{ monitoring_deploy_path }}/grafana:/var/lib/grafana
      - {{ monitoring_deploy_path }}/grafana/provisioning:/etc/grafana/provisioning:ro
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"

  # Host networking so the exporters can reach chronyd's command port
  # (127.0.0.1:323) and expose host metrics.
  chrony-exporter:
    image: {{ chrony_exporter_image }}
    container_name: chrony-exporter
    restart: unless-stopped
    network_mode: host
    command:
      - '--chrony.address=127.0.0.1:323'
      - '--collector.sources'

  gpsd-exporter:
    image: {{ gpsd_exporter_image }}
    container_name: gpsd-exporter
    restart: unless-stopped
    network_mode: host

  node-exporter:
    image: {{ node_exporter_image }}
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - '--path.rootfs=/host'
      - '--collector.textfile.directory=/textfile'
    volumes:
      - '/:/host:ro,rslave'
      - '{{ monitoring_deploy_path }}/textfile:/textfile:ro'
