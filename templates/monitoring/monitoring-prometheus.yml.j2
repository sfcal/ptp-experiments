# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'chrony'
    static_configs:
      - targets: ['host.docker.internal:9123']

  - job_name: 'node'
    static_configs:
      - targets: ['host.docker.internal:9100']
        labels:
          role: grandmaster
          host: grandmaster

  - job_name: 'gpsd'
    static_configs:
      - targets: ['host.docker.internal:9015']

  - job_name: 'ptp_clients'
    static_configs:
{% for host in groups['ptp_clients'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_host | default(host) }}:9100']
        labels:
          role: slave
          host: '{{ host }}'
{% endfor %}
