[global]

# See: https://austinsnerdythings.com/2025/02/18/nanosecond-accurate-ptp-server-grandmaster-and-client-tutorial-for-raspberry-pi/

# Log level (0 = disabled, 1 = print to stdout)
verbose 1

# Force hardware timestamping
time_stamping         hardware

{% if ptp_role == 'grandmaster' %}
# Act only as a master. ('serverOnly' on later versions...)
masterOnly 1

# BMCA priorities (lower wins)
priority1 127
priority2 127

# clockClass=6 for GNSS reference
# other classes = https://documentation.nokia.com/srlinux/24-10/books/network-synchronization/ieee-1588-ptp.html
clockClass 6

# 0x20 = time accurate to within 25ns
clockAccuracy 0x20

# Sync message rate: 2^-3 = 8 msgs/sec
logSyncInterval -3

# Announce message rate: 2^0 = 1 msg/sec
logAnnounceInterval 0
{% else %}
# Act only as a slave. ('clientOnly' on later versions...)
slaveOnly 1

# CM5/RP1 NIC only hardware-timestamps PTPv2.0 frames; linuxptp 4.x
# sends v2.1 by default, so force minor version 0.
# See: https://github.com/jclark/rpi-cm4-ptp-guide/issues/40
ptp_minor_version 0

# The RP1 driver can be slow returning TX timestamps (default is 1ms).
tx_timestamp_timeout 100
{% endif %}
