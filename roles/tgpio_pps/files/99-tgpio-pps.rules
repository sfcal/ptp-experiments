# Managed by Ansible (roles/tgpio_pps).
# Arm the Intel PMC TGPIO 1PPS generators at boot. On the LattePanda Mu the
# TIME_SYNC1 block (ACPI INTC1024) drives GPP_B14 = edge-connector pin 123.
# TIME_SYNC0 (INTC1023) drives GPP_B15, whose pad output buffer the BIOS
# disables and locks, so arming that one is a no-op.
#
# Deliberately matches EVERY pps-gen device rather than naming pps-gen1:
# these are parentless virtual devices with no parent, no DRIVER and only
# enable/system/time attributes, so there is nothing stable to match on, and
# the index depends on the ACPI TGEA/TGEB gates -- which have already moved
# pin 123 from pps-gen0 to pps-gen1 once.
#
# 'enable' is write-only (0200); there is no way to read the state back.
# To confirm the block is toggling, see the "TGPIO 1PPS on LattePanda Mu
# pin 123" note -- it documents the /dev/mem register read.
ACTION=="add", SUBSYSTEM=="pps-gen", ATTR{enable}="1"
