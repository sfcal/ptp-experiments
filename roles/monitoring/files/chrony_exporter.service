# Managed by Ansible (roles/monitoring).
[Unit]
Description=Prometheus exporter for chrony
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
# Unprivileged: monitoring commands to chronyd's loopback UDP cmdport only;
# metrics on the default :9123.
DynamicUser=yes
ExecStart=/usr/local/sbin/chrony_exporter --chrony.address=127.0.0.1:323 --collector.sources
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
