# {{ ansible_managed }}
[Unit]
Description=Configure Timecard SMA input/output routing
# Route the SMA PPS before ts2phc (which disciplines the NIC PHC from it)
# starts.
Before=ts2phc.service ptp4l.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/timecard-sma.sh

[Install]
WantedBy=multi-user.target
