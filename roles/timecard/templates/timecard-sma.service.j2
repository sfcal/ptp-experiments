# {{ ansible_managed }}
[Unit]
Description=Configure Timecard SMA input/output routing
# Route signals (and enable kernel PPS events) before the daemons that
# consume them start.
Before=ts2phc.service ptp4l.service gpsd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/timecard-sma.sh

[Install]
WantedBy=multi-user.target
