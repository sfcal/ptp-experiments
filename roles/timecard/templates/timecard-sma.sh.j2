#!/usr/bin/env bash
# {{ ansible_managed }}
# Apply Timecard SMA routing (ptp_ocp sysfs writes do not survive reboot).
# Available values: cat $SYSFS/available_sma_inputs / available_sma_outputs
set -euo pipefail

SYSFS="/sys/class/timecard/ocp0"

# Wait for the driver to probe at boot.
for _ in $(seq 30); do
  [ -d "$SYSFS" ] && break
  sleep 1
done
[ -d "$SYSFS" ] || { echo "timecard ocp0 not present after 30s" >&2; exit 1; }

{% for sma, mode in timecard_sma | dictsort %}
if [ "$(cat "$SYSFS/{{ sma }}")" != "{{ mode }}" ]; then
  echo "{{ mode }}" > "$SYSFS/{{ sma }}"
  echo "{{ sma }} <- {{ mode }}"
fi
{% endfor %}
