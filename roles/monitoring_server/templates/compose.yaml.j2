# {{ ansible_managed }}
---
networks:
  monitoring:
    driver: bridge

services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    networks:
      - monitoring
    extra_hosts:
      - "host.docker.internal:host-gateway"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention }}'
    ports:
      - "{{ prometheus_port }}:9090"
    volumes:
      - {{ monitoring_deploy_path }}/prometheus:/etc/prometheus:ro
      - {{ monitoring_deploy_path }}/prometheus-data:/prometheus
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"

  # Host networking so the exporters can reach chronyd's command port
  # (127.0.0.1:323) and expose host metrics.
  chrony-exporter:
    image: {{ chrony_exporter_image }}
    container_name: chrony-exporter
    restart: unless-stopped
    network_mode: host
    command:
      - '--chrony.address=127.0.0.1:323'
      - '--collector.sources'

  gpsd-exporter:
    image: {{ gpsd_exporter_image }}
    container_name: gpsd-exporter
    restart: unless-stopped
    network_mode: host
    # PPS histogram feeds the GPSD dashboard's "Clock offset from PPS" panels.
    # The image is configured via env vars consumed by its entrypoint.sh (it
    # has no ENTRYPOINT, so compose `command` would replace the launch line):
    # a non-empty PPS_TIME1 turns on --pps-histogram; 0 = no offset correction.
    environment:
      PPS_TIME1: "0"
      PPS_BUCKET_SIZE: "{{ gpsd_exporter_pps_bucket_ns }}"
      PPS_BUCKET_COUNT: "{{ gpsd_exporter_pps_bucket_count }}"

  node-exporter:
    image: {{ node_exporter_image }}
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - '--path.rootfs=/host'
      - '--collector.textfile.directory=/textfile'
    volumes:
      - '/:/host:ro,rslave'
      - '{{ monitoring_deploy_path }}/textfile:/textfile:ro'
