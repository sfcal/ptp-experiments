#!/bin/sh
# {{ ansible_managed }}
# Poll ptp4l via pmc and publish Prometheus metrics through the
# node_exporter textfile collector.
OUT="{{ ptp_metrics_textfile_dir }}/ptp4l.prom"
TMP="${OUT}.tmp"

# Absolute path: pmc must come from the same build as the running ptp4l
# so their management socket defaults match.
PMC_OUT=$({{ linuxptp_sbin }}/pmc -u -b 0 'GET PORT_DATA_SET' 'GET CURRENT_DATA_SET' 'GET PARENT_DATA_SET' 2>/dev/null)

if [ -z "$PMC_OUT" ]; then
    printf '# HELP ptp4l_up Whether ptp4l is running and answering pmc queries.\n# TYPE ptp4l_up gauge\nptp4l_up 0\n' > "$TMP"
    mv "$TMP" "$OUT"
    exit 0
fi

echo "$PMC_OUT" | awk '
    /portState/          { state = $2 }
    /offsetFromMaster/   { offset = $2 }
    /meanPathDelay/      { delay = $2 }
    /gm.ClockClass/      { cc = $2 }
    /stepsRemoved/       { steps = $2 }
    END {
        smap["INITIALIZING"] = 1; smap["FAULTY"] = 2; smap["DISABLED"] = 3
        smap["LISTENING"] = 4; smap["PRE_MASTER"] = 5; smap["MASTER"] = 6
        smap["PASSIVE"] = 7; smap["UNCALIBRATED"] = 8; smap["SLAVE"] = 9
        print "# HELP ptp4l_up Whether ptp4l is running and answering pmc queries."
        print "# TYPE ptp4l_up gauge"
        print "ptp4l_up 1"
        if (state != "") {
            print "# HELP ptp4l_port_state PTP port state (4=LISTENING, 6=MASTER, 9=SLAVE)."
            print "# TYPE ptp4l_port_state gauge"
            printf "ptp4l_port_state{state=\"%s\"} %d\n", state, smap[state]
        }
        if (offset != "") {
            print "# HELP ptp4l_offset_from_master_ns Offset from master in nanoseconds (0 when master)."
            print "# TYPE ptp4l_offset_from_master_ns gauge"
            printf "ptp4l_offset_from_master_ns %s\n", offset
        }
        if (delay != "") {
            print "# HELP ptp4l_mean_path_delay_ns Mean path delay in nanoseconds."
            print "# TYPE ptp4l_mean_path_delay_ns gauge"
            printf "ptp4l_mean_path_delay_ns %s\n", delay
        }
        if (cc != "") {
            print "# HELP ptp4l_gm_clock_class Grandmaster clock class (6=GNSS-locked)."
            print "# TYPE ptp4l_gm_clock_class gauge"
            printf "ptp4l_gm_clock_class %s\n", cc
        }
        if (steps != "") {
            print "# HELP ptp4l_steps_removed Steps removed from the grandmaster."
            print "# TYPE ptp4l_steps_removed gauge"
            printf "ptp4l_steps_removed %s\n", steps
        }
    }
' > "$TMP"

{% if ptp_role != 'grandmaster' %}
# chrony disciplines the system clock on clients. Metric names match the
# GM's chrony-exporter so the semantics stay uniform (job labels keep the
# series apart).
# chronyc -c tracking CSV: refid,refname,stratum,reftime,sysoff,lastoff,
#                          rmsoff,freq_ppm,residfreq,skew,rootdelay,rootdisp,
#                          interval,leapstatus
TRACKING=$(chronyc -c tracking 2>/dev/null)

if [ -z "$TRACKING" ]; then
    printf '# HELP chrony_up Whether chronyd is running and answering tracking queries.\n# TYPE chrony_up gauge\nchrony_up 0\n' >> "$TMP"
else
    echo "$TRACKING" | awk -F, '
        {
            print "# HELP chrony_up Whether chronyd is running and answering tracking queries."
            print "# TYPE chrony_up gauge"
            print "chrony_up 1"
            print "# HELP chrony_ref_locked Whether chrony is locked to the NIC PHC refclock."
            print "# TYPE chrony_ref_locked gauge"
            printf "chrony_ref_locked %d\n", ($2 == "PHC" && $14 == "Normal") ? 1 : 0
            print "# HELP chrony_tracking_last_offset_seconds Last measured system clock offset in seconds."
            print "# TYPE chrony_tracking_last_offset_seconds gauge"
            printf "chrony_tracking_last_offset_seconds %s\n", $6
            print "# HELP chrony_tracking_rms_offset_seconds Long-term RMS system clock offset in seconds."
            print "# TYPE chrony_tracking_rms_offset_seconds gauge"
            printf "chrony_tracking_rms_offset_seconds %s\n", $7
            print "# HELP chrony_tracking_frequency_ppms Clock frequency error in ppm (negative = slow)."
            print "# TYPE chrony_tracking_frequency_ppms gauge"
            printf "chrony_tracking_frequency_ppms %s\n", $8
        }
    ' >> "$TMP"
fi
{% endif %}

{% if gm_ts2phc_enabled | default(false) %}
# ts2phc journal output, e.g.:
#   [55280.895] /dev/ptp2 offset        12 s2 freq     -34
# The unit's phc2sys presync (ExecStartPre) logs "/dev/ptp0 phc offset ..."
# into the same journal; exclude those lines or a restart while the Timecard
# is wedged reports bogus stats (2026-08-14: offset -4.29e18 ns, servo s2).
TS2PHC_JOURNAL=$(journalctl -u ts2phc -o cat --no-pager --since "-30 seconds" 2>/dev/null)
TS2PHC_LINE=$(echo "$TS2PHC_JOURNAL" | grep ' offset ' | grep -v 'phc offset' | tail -1)

if [ -z "$TS2PHC_LINE" ]; then
    printf '# HELP ts2phc_up Whether ts2phc is running and reporting sync stats.\n# TYPE ts2phc_up gauge\nts2phc_up 0\n' >> "$TMP"
else
    echo "$TS2PHC_LINE" | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "offset") offset = $(i+1)
                if ($i == "freq")   freq = $(i+1)
                if ($i ~ /^s[0-9]$/) servo = substr($i, 2)
            }
        }
        END {
            print "# HELP ts2phc_up Whether ts2phc is running and reporting sync stats."
            print "# TYPE ts2phc_up gauge"
            print "ts2phc_up 1"
            if (offset != "") {
                print "# HELP ts2phc_offset_ns Offset of the synced PHC from the PPS source in nanoseconds."
                print "# TYPE ts2phc_offset_ns gauge"
                printf "ts2phc_offset_ns %s\n", offset
            }
            if (servo != "") {
                print "# HELP ts2phc_servo_state Servo state (0=unlocked, 1=step, 2=locked)."
                print "# TYPE ts2phc_servo_state gauge"
                printf "ts2phc_servo_state %s\n", servo
            }
            if (freq != "") {
                print "# HELP ts2phc_freq_ppb Frequency adjustment in parts per billion."
                print "# TYPE ts2phc_freq_ppb gauge"
                printf "ts2phc_freq_ppb %s\n", freq
            }
        }
    ' >> "$TMP"
fi

# ts2phc logs "poll returns zero, no events" every ~2s while it runs with no
# PPS edges arriving (wedged FPGA, SMA routing lost, cable out). Positive
# signature: distinguishes "running but eventless" from "not running at all"
# (2026-08-14: ptp4l served the free-running NIC PHC all day like this).
if echo "$TS2PHC_JOURNAL" | grep -q 'poll returns zero'; then
    TS2PHC_NO_EVENTS=1
else
    TS2PHC_NO_EVENTS=0
fi
printf '# HELP ts2phc_no_pps_events ts2phc is running but received no PPS events in the last 30s.\n# TYPE ts2phc_no_pps_events gauge\nts2phc_no_pps_events %s\n' "$TS2PHC_NO_EVENTS" >> "$TMP"
{% endif %}

{% if gm_phc2sys_enabled | default(false) %}
# phc2sys journal output, e.g.:
#   CLOCK_REALTIME phc offset       -42 s2 freq   -1234 delay    980
PHC2SYS_LINE=$(journalctl -u phc2sys -o cat --no-pager --since "-30 seconds" 2>/dev/null | grep ' offset ' | tail -1)

if [ -z "$PHC2SYS_LINE" ]; then
    printf '# HELP phc2sys_up Whether phc2sys is running and reporting sync stats.\n# TYPE phc2sys_up gauge\nphc2sys_up 0\n' >> "$TMP"
else
    echo "$PHC2SYS_LINE" | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "offset") offset = $(i+1)
                if ($i == "freq")   freq = $(i+1)
                if ($i ~ /^s[0-9]$/) servo = substr($i, 2)
            }
        }
        END {
            print "# HELP phc2sys_up Whether phc2sys is running and reporting sync stats."
            print "# TYPE phc2sys_up gauge"
            print "phc2sys_up 1"
            if (offset != "") {
                print "# HELP phc2sys_offset_ns Offset of the NIC PHC from the system clock in nanoseconds."
                print "# TYPE phc2sys_offset_ns gauge"
                printf "phc2sys_offset_ns %s\n", offset
            }
            if (servo != "") {
                print "# HELP phc2sys_servo_state Servo state (0=unlocked, 1=step, 2=locked)."
                print "# TYPE phc2sys_servo_state gauge"
                printf "phc2sys_servo_state %s\n", servo
            }
            if (freq != "") {
                print "# HELP phc2sys_freq_ppb Frequency adjustment in parts per billion."
                print "# TYPE phc2sys_freq_ppb gauge"
                printf "phc2sys_freq_ppb %s\n", freq
            }
        }
    ' >> "$TMP"
fi
{% endif %}

{% if ptp_role == 'grandmaster' %}
# timecard-sma.service is a boot oneshot (SMA routing + kernel PPS enable);
# it fails when the FPGA comes up wedged (sysfs writes return EOPNOTSUPP).
if [ "$(systemctl is-failed timecard-sma.service 2>/dev/null)" = "failed" ]; then
    TIMECARD_SMA_FAILED=1
else
    TIMECARD_SMA_FAILED=0
fi
printf '# HELP timecard_sma_failed Whether timecard-sma.service is in the systemd failed state.\n# TYPE timecard_sma_failed gauge\ntimecard_sma_failed %s\n' "$TIMECARD_SMA_FAILED" >> "$TMP"
{% endif %}
mv "$TMP" "$OUT"
