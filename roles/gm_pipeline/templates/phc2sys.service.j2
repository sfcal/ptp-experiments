# {{ ansible_managed }}
[Unit]
Description=Sync NIC PHC from the system clock (phc2sys)
After=network-online.target ptp4l.service
Wants=network-online.target
# -w takes the UTC-TAI offset from ptp4l's data set.
Requires=ptp4l.service

[Service]
Type=simple
ExecStart={{ linuxptp_sbin }}/phc2sys -s {{ phc2sys_source }} -c {{ phc2sys_clock }} --step_threshold=1 {{ phc2sys_extra_opts }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
