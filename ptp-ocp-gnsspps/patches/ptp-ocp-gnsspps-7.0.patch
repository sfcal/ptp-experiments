+
+/* gnsspps: feed the kernel PPS device (/dev/ppsN) from the raw GNSS 1PPS
+ * timestamper (ts0) instead of the disciplined FPGA PPS timestamper. The
+ * raw pulse then keeps true GNSS semantics: asserts stop when the receiver
+ * stops pulsing, instead of free-running on the disciplined clock.
+ */
+static bool gnss_pps;
+module_param(gnss_pps, bool, 0444);
+MODULE_PARM_DESC(gnss_pps,
+		 "Feed the kernel PPS device from the raw GNSS 1PPS timestamper (ts0) instead of the disciplined FPGA PPS (default 0)");
+
+static struct ptp_ocp_ext_src *
+ptp_ocp_pps_source(struct ptp_ocp *bp)
+{
+	return gnss_pps ? bp->ts0 : bp->pps;
 }
 
